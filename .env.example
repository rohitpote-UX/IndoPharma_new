# ==============================================================================
# INDOPHARM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env or secrets to version control.
# ==============================================================================

# Core Application Settings
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="IndoPharm"

# Database Configuration (PostgreSQL via Prisma)
# DATABASE_URL: Pooled connection string (e.g., PgBouncer)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/indopharm?schema=public&pgbouncer=true"
# DIRECT_URL: Direct non-pooled connection for migrations and schema introspection
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/indopharm?schema=public"

# Session & Security
# Generate using: openssl rand -base64 32
SESSION_SECRET="change-this-to-a-secure-random-secret-in-production-min-32-chars"
FIELD_ENCRYPTION_KEY="01234567890123456789012345678901" # 32-byte hex/ascii key for ePHI

# Agnostic Payment Gateway Configuration
# Active provider adapter: "mock" (default for development), "acquirer-x", etc.
PAYMENT_PROVIDER="mock"
PAYMENT_PUBLIC_KEY="pk_test_placeholder"
PAYMENT_SECRET_KEY="sk_test_placeholder"
PAYMENT_WEBHOOK_SECRET="whsec_placeholder"
PAYMENT_PROVIDER_MOCK_WEBHOOK_SECRET="whsec_mock_dev_secret"
PAYMENT_CAPTURE_MODE="manual" # "manual" | "automatic"
PAYMENT_INTENT_EXPIRY_SECONDS=1800
PAYMENT_MOCK_GUARD="true" # prevents mock adapter in production

# Secure Document Storage (S3-Compatible / Private ePHI Bucket)
STORAGE_ENDPOINT="https://s3.us-east-1.amazonaws.com"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="indopharm-prescriptions-private"
STORAGE_ACCESS_KEY="mock_storage_access_key"
STORAGE_SECRET_KEY="mock_storage_secret_key"

# Transactional Notifications (Email / SMS)
EMAIL_PROVIDER="mock" # "resend" | "postmark" | "sendgrid" | "mock"
EMAIL_API_KEY="mock_email_api_key"
EMAIL_FROM="notifications@indopharm.com"

# Privacy-Preserving Analytics
ANALYTICS_KEY="mock_analytics_key"
