// ==============================================================================
// INDOPHARM — PRISMA SCHEMA DEFINITION
// ==============================================================================
// Database: PostgreSQL 16+
// Target: High-Integrity Cross-Border Pharmaceutical Commerce
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  CLINICAL_PHARMACIST
  OPS_WAREHOUSE
  COMPLIANCE_ADMIN
  SUPPORT_AGENT
}

enum AddressType {
  SHIPPING
  BILLING
}

enum PrescriptionStatus {
  PENDING_REVIEW
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

enum OrderStatus {
  PENDING_PRESCRIPTION
  UNDER_CLINICAL_REVIEW
  CONFIRMED_PICKING
  EXPORT_CUSTOMS
  IN_TRANSIT_AIR
  US_CUSTOMS_CLEARANCE
  DOMESTIC_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  DRAFT
  REQUIRES_PAYMENT_METHOD
  REQUIRES_CONFIRMATION
  REQUIRES_ACTION
  AUTHORIZED
  CAPTURED
  CANCELED
  REFUNDED
  FAILED
}

enum ShipmentStage {
  INDIA_BONDED_HUB
  INDIA_EXPORT_CUSTOMS
  INTERNATIONAL_AIR_TRANSIT
  US_PORT_OF_ENTRY
  OUT_FOR_DELIVERY
  DELIVERED
}

enum RewardStatus {
  PENDING
  CONFIRMED
  REDEEMED
  EXPIRED
}

// ------------------------------------------------------------------------------
// User & Authentication
// ------------------------------------------------------------------------------

model User {
  id               String      @id @default(uuid())
  email            String      @unique
  passwordHash     String?
  role             UserRole    @default(PATIENT)
  firstName        String
  lastName         String
  phone            String?     // Application-layer encrypted
  dateOfBirth      DateTime?   // Application-layer encrypted
  emailVerified    Boolean     @default(false)
  twoFactorEnabled Boolean     @default(false)

  // Relations
  addresses             Address[]
  orders                Order[]
  prescriptions         Prescription[]           @relation("PatientPrescriptions")
  verifiedPrescriptions Prescription[]           @relation("PharmacistVerifications")
  referralsMade         ReferralReward[]         @relation("Referrer")
  referralsReceived     ReferralReward[]         @relation("ReferredUser")
  auditLogs             AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}

model Address {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        AddressType @default(SHIPPING)
  line1       String
  line2       String?
  city        String
  state       String
  postalCode  String
  country     String      @default("US")
  isDefault   Boolean     @default(false)

  orders      Order[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
}

// ------------------------------------------------------------------------------
// Sourcing, Products & Quality Provenance
// ------------------------------------------------------------------------------

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
}

model Manufacturer {
  id                      String    @id @default(uuid())
  name                    String    @unique
  cdscoLicenseNumber      String    @unique
  usFdaRegistrationNumber String?
  facilityCity            String
  facilityState           String
  whoGmpCertified         Boolean   @default(true)
  verifiedAt              DateTime  @default(now())

  products                Product[]

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model Product {
  id                    String             @id @default(uuid())
  sku                   String             @unique @default(cuid())
  name                  String             // Generic active name (e.g. "Atorvastatin Calcium")
  brandReferenceName    String             // e.g. "Generic for Lipitor"
  slug                  String             @unique
  activeIngredient      String
  strength              String             // e.g. "20mg"
  dosageForm            String             // e.g. "Oral Tablet"
  packageSize           Int                @default(90) // Standard 90-day count
  ndcEquivalent         String?            // Reference U.S. NDC mapping
  description           String             @db.Text
  storageConditions     String             @default("Store at 20°C to 25°C (68°F to 77°F)")
  countryOfOrigin       String             @default("India")
  stockStatus           String             @default("AVAILABLE") // AVAILABLE, LOW_STOCK, OUT_OF_STOCK, REGULATORY_REVIEW, NOT_ELIGIBLE, PRESCRIPTION_REQUIRED
  
  // Transparent Pricing Model (USD)
  fobPriceUsd           Decimal            @db.Decimal(10, 2) // Origin manufacturing cost
  retailPriceUsd        Decimal            @db.Decimal(10, 2) // IndoPharm price to patient
  usAverageCashPrice    Decimal            @db.Decimal(10, 2) // Reference domestic cash benchmark

  // Regulatory Constraints
  isControlledSubstance Boolean            @default(false) // Barred if true
  requiresPrescription  Boolean            @default(true)
  isActive              Boolean            @default(true)

  manufacturerId        String
  manufacturer          Manufacturer       @relation(fields: [manufacturerId], references: [id])
  
  categoryId            String?
  category              Category?          @relation(fields: [categoryId], references: [id])

  // Relations
  batchCertificates     BatchCertificate[]
  productDocuments      ProductDocument[]
  regulatoryRecords     RegulatoryRecord[]
  shippingEligibilities ShippingEligibility[]
  productFaqs           ProductFAQ[]
  orderItems            OrderItem[]
  productEligibilities  ProductEligibility[]
  cartItems             CartItem[]

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([slug])
  @@index([sku])
  @@index([name])
  @@index([brandReferenceName])
  @@index([activeIngredient])
  @@index([manufacturerId])
  @@index([categoryId])
}

model BatchCertificate {
  id                  String      @id @default(uuid())
  productId           String
  product             Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  lotNumber           String      @unique
  manufactureDate     DateTime
  expirationDate      DateTime
  purityPercentage    Decimal     @db.Decimal(5, 2) // e.g. 99.85%
  coaDocumentUrl      String      // Encrypted private S3 URL
  releasedByQcOfficer String
  releasedAt          DateTime    @default(now())

  orderItems          OrderItem[]

  createdAt           DateTime    @default(now())

  @@index([productId])
  @@index([lotNumber])
}

model ProductDocument {
  id                 String   @id @default(uuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type               String   // "COA", "SPECIFICATION", "MANUFACTURER_LICENSE", "PACKAGING_INSERT", "REGULATORY"
  title              String
  fileUrl            String
  verificationStatus String   @default("VERIFIED") // "VERIFIED", "PENDING_AUDIT", "UNVERIFIED"
  uploadedAt         DateTime @default(now())

  createdAt          DateTime @default(now())

  @@index([productId])
  @@index([type])
}

model RegulatoryRecord {
  id           String    @id @default(uuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  jurisdiction String    // e.g. "US_FDA", "IN_CDSCO", "UK_MHRA"
  status       String    // e.g. "CPG_110_300_PERSONAL_USE", "EXPORT_CLEARED", "SCHEDULE_H_RESTRICTED"
  reference    String    // Statutory citation or certificate number
  verifiedAt   DateTime  @default(now())
  expiresAt    DateTime?

  createdAt    DateTime  @default(now())

  @@index([productId])
  @@index([jurisdiction])
}

model ShippingEligibility {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  destination String   // e.g. "US", "IN", "CA", "GB"
  status      String   // "AVAILABLE", "RESTRICTED", "REVIEW_REQUIRED", "NOT_AVAILABLE"
  reason      String?  // Legal/operational explanation for status
  updatedAt   DateTime @updatedAt

  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([destination])
}

model ProductFAQ {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  question     String
  answer       String   @db.Text
  displayOrder Int      @default(0)

  createdAt    DateTime @default(now())

  @@index([productId])
}

// ------------------------------------------------------------------------------
// Clinical Prescriptions (ePHI Protected)
// ------------------------------------------------------------------------------

model Prescription {
  id                 String             @id @default(uuid())
  userId             String
  user               User               @relation("PatientPrescriptions", fields: [userId], references: [id], onDelete: Cascade)

  prescriberName     String
  prescriberNpi      String?            // Application-level encrypted
  prescriberState    String?
  documentUrl        String             // Encrypted private storage key
  mimeType           String             @default("application/pdf")
  fileSizeBytes      Int

  status             PrescriptionStatus @default(PENDING_REVIEW)
  verificationNotes  String?            @db.Text
  verifiedByUserId   String?
  verifiedByUser     User?              @relation("PharmacistVerifications", fields: [verifiedByUserId], references: [id])
  verifiedAt         DateTime?
  expiresAt          DateTime?

  refillsAuthorized  Int                @default(3)
  refillsRemaining   Int                @default(3)

  orders             Order[]

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

// ------------------------------------------------------------------------------
// Orders, Checkout & Items
// ------------------------------------------------------------------------------

model Order {
  id                 String              @id @default(uuid())
  orderNumber        String              @unique
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  status             OrderStatus         @default(PENDING_PRESCRIPTION)

  // Financial Breakdown (USD)
  subtotalUsd        Decimal             @db.Decimal(10, 2)
  shippingUsd        Decimal             @db.Decimal(10, 2)
  dispensingFeeUsd   Decimal             @db.Decimal(10, 2)
  totalUsd           Decimal             @db.Decimal(10, 2)

  // Addresses & Prescriptions
  shippingAddressId  String
  shippingAddress    Address             @relation(fields: [shippingAddressId], references: [id])
  prescriptionId     String?
  prescription       Prescription?       @relation(fields: [prescriptionId], references: [id])

  // Relations
  items              OrderItem[]
  paymentTransaction PaymentTransaction?
  shipment           Shipment?

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
}

model OrderItem {
  id                 String            @id @default(uuid())
  orderId            String
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product           @relation(fields: [productId], references: [id])
  batchCertificateId String?
  batchCertificate   BatchCertificate? @relation(fields: [batchCertificateId], references: [id])

  quantity           Int               @default(1)
  unitPriceUsd       Decimal           @db.Decimal(10, 2)
  totalPriceUsd      Decimal           @db.Decimal(10, 2)

  createdAt          DateTime          @default(now())

  @@index([orderId])
  @@index([productId])
}

// ------------------------------------------------------------------------------
// Gateway-Agnostic Payment Transaction Ledger
// ------------------------------------------------------------------------------

model PaymentTransaction {
  id                    String        @id @default(uuid())
  orderId               String        @unique
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  providerId            String        // e.g. "mock", "stripe", "checkout-com", "healthcare-acquirer"
  externalTransactionId String?       @unique
  status                PaymentStatus @default(DRAFT)
  amountUsd             Decimal       @db.Decimal(10, 2)
  currency              String        @default("USD")
  
  authorizedAt          DateTime?
  capturedAt            DateTime?
  refundedAt            DateTime?
  failureReason         String?

  metadata              Json?

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
}

// ------------------------------------------------------------------------------
// Cross-Border Fulfillment & Milestone Logistics
// ------------------------------------------------------------------------------

model Shipment {
  id             String          @id @default(uuid())
  orderId        String          @unique
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  carrier        String          // "DHL_EXPRESS" | "FEDEX_CROSSBORDER" | "USPS"
  trackingNumber String          @unique
  currentStage   ShipmentStage   @default(INDIA_BONDED_HUB)
  originCountry  String          @default("IN")
  destinationCountry String      @default("US")
  
  estimatedDelivery DateTime?
  actualDelivery    DateTime?

  events         TrackingEvent[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([orderId])
  @@index([trackingNumber])
}

model TrackingEvent {
  id          String        @id @default(uuid())
  shipmentId  String
  shipment    Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  stage       ShipmentStage
  location    String        // e.g., "Mumbai Hub, India" or "JFK Airport, NY"
  description String
  eventTime   DateTime      @default(now())

  createdAt   DateTime      @default(now())

  @@index([shipmentId])
  @@index([eventTime])
}

// ------------------------------------------------------------------------------
// Retention, Adherence & Referrals
// ------------------------------------------------------------------------------

model ReferralReward {
  id             String       @id @default(uuid())
  referrerId     String
  referrer       User         @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId String       @unique
  referredUser   User         @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  creditUsd      Decimal      @db.Decimal(10, 2) @default(20.00)
  status         RewardStatus @default(PENDING)
  redeemedAt     DateTime?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([referrerId])
  @@index([referredUserId])
}

// ------------------------------------------------------------------------------
// Immutable Security & Compliance Audit Trail
// ------------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userRole     String?
  action       String   // e.g. "PRESCRIPTION_VIEWED", "ORDER_APPROVED", "EXPORT_MANIFEST_FILED"
  resourceType String   // e.g. "Prescription", "Order", "User"
  resourceId   String
  ipAddress    String?
  userAgent    String?
  metadata     Json?

  timestamp    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([timestamp])
}

// ------------------------------------------------------------------------------
// Multi-Country, Jurisdiction & Operational Product Eligibility Engine
// ------------------------------------------------------------------------------

model Country {
  id                   String               @id @default(uuid())
  code                 String               @unique // e.g. "US", "IN", "GB", "CA"
  name                 String               // e.g. "United States", "India"
  currency             String               @default("USD") // e.g. "USD", "INR"
  phoneCode            String?              // e.g. "+1", "+91"
  isActive             Boolean              @default(true)

  jurisdictions        Jurisdiction[]
  productEligibilities ProductEligibility[]

  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([code])
  @@index([isActive])
}

model Jurisdiction {
  id                   String               @id @default(uuid())
  countryId            String
  country              Country              @relation(fields: [countryId], references: [id], onDelete: Cascade)
  code                 String               @unique // e.g. "US-CA", "US-NY", "IN-MH"
  name                 String               // e.g. "California", "New York", "Maharashtra"
  type                 String               @default("STATE") // "STATE", "PROVINCE", "TERRITORY"
  isActive             Boolean              @default(true)

  productEligibilities ProductEligibility[]

  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([countryId])
  @@index([code])
}

model ProductEligibility {
  id                   String        @id @default(uuid())
  productId            String
  product              Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  countryId            String
  country              Country       @relation(fields: [countryId], references: [id], onDelete: Cascade)
  jurisdictionId       String?
  jurisdiction         Jurisdiction? @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)

  status               String        // "ELIGIBLE", "REVIEW_REQUIRED", "PRESCRIPTION_REQUIRED", "VERIFICATION_REQUIRED", "DESTINATION_RESTRICTED", "OUT_OF_STOCK", "FULFILLMENT_UNAVAILABLE", "NOT_AVAILABLE"
  prescriptionRequired Boolean       @default(true)
  verificationRequired Boolean       @default(false)
  shippingAllowed      Boolean       @default(true)
  fulfillmentAllowed   Boolean       @default(true)
  maxSupplyDays        Int           @default(90) // e.g. 90-day maintenance personal importation limit
  reason               String?       // Legal or business operational rationale

  effectiveFrom        DateTime      @default(now())
  effectiveUntil       DateTime?
  lastReviewedAt       DateTime      @default(now())
  reviewedBy           String?       // Compliance officer ID or system tag

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([productId])
  @@index([countryId])
  @@index([jurisdictionId])
  @@index([status])
}

// ------------------------------------------------------------------------------
// Cart & Session Architecture
// ------------------------------------------------------------------------------

model Cart {
  id                         String            @id @default(uuid())
  sessionToken               String            @unique
  userId                     String?
  destinationCountryCode     String            @default("US")
  destinationJurisdictionCode String?
  status                     String            @default("ACTIVE") // "ACTIVE", "CONVERTED", "EXPIRED", "ABANDONED"

  items                      CartItem[]
  checkoutSessions           CheckoutSession[]

  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  @@index([sessionToken])
  @@index([userId])
  @@index([status])
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

// ------------------------------------------------------------------------------
// Checkout Session & State Machine
// ------------------------------------------------------------------------------

model CheckoutSession {
  id                         String    @id @default(uuid())
  cartId                     String
  cart                       Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sessionToken               String
  userId                     String?
  status                     String    @default("CUSTOMER_INFO") // "CUSTOMER_INFO", "ADDRESS", "PRESCRIPTION", "VERIFICATION", "SHIPPING", "PAYMENT", "REVIEW", "PROCESSING", "COMPLETED", "EXPIRED"

  currency                   String    @default("USD")
  destinationCountryCode     String    @default("US")
  destinationJurisdictionCode String?

  subtotalUsd                Decimal   @db.Decimal(10, 2)
  shippingUsd                Decimal   @db.Decimal(10, 2)
  estimatedTaxUsd            Decimal   @db.Decimal(10, 2) @default(0.00)
  totalUsd                   Decimal   @db.Decimal(10, 2)

  eligibilitySnapshot        Json?
  customerInfo               Json?
  shippingAddress            Json?
  shippingMethod             Json?
  prescriptionRef            String?
  verificationRef            String?

  idempotencyKey             String    @unique
  orderId                    String?   @unique

  expiresAt                  DateTime
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([cartId])
  @@index([sessionToken])
  @@index([idempotencyKey])
  @@index([status])
}

