// ==============================================================================
// INDOPHARM — PRISMA SCHEMA DEFINITION (PHASE 16 DATABASE ARCHITECTURE)
// ==============================================================================
// Database: PostgreSQL 16+
// Driver: @prisma/adapter-pg (PrismaPg connection pool)
// Target: Production-Grade Pharmaceutical Commerce Database
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------------------

enum UserRole {
  PATIENT
  CLINICAL_PHARMACIST
  OPS_WAREHOUSE
  COMPLIANCE_ADMIN
  SUPPORT_AGENT
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
  HEALTHCARE_PROFESSIONAL
  PHARMACY
  ORGANIZATION
}

enum AddressType {
  SHIPPING
  BILLING
}

enum PrescriptionStatus {
  UPLOADED
  PENDING_REVIEW
  UNDER_REVIEW
  MORE_INFORMATION_REQUIRED
  VERIFIED
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
}

enum OrderStatus {
  PENDING_PRESCRIPTION
  UNDER_CLINICAL_REVIEW
  PAYMENT_PROCESSING          // Payment intent created, awaiting provider confirmation
  PAYMENT_FAILED              // Payment definitively failed
  CONFIRMED_PICKING           // Payment verified; order picked for dispatch
  EXPORT_CUSTOMS
  IN_TRANSIT_AIR
  US_CUSTOMS_CLEARANCE
  DOMESTIC_DELIVERY
  DELIVERED
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

// Legacy PaymentStatus — kept for PaymentTransaction backwards compatibility.
// New code uses InternalPaymentStatus on the Payment model.
enum PaymentStatus {
  DRAFT
  REQUIRES_PAYMENT_METHOD
  REQUIRES_CONFIRMATION
  REQUIRES_ACTION
  AUTHORIZED
  CAPTURED
  CANCELED
  REFUNDED
  FAILED
}

// Full normalized payment status for Phase 15+ Payment model.
enum InternalPaymentStatus {
  CREATED               // Payment record created; no provider action yet
  REQUIRES_ACTION       // Awaiting 3DS / OTP / additional customer step
  PENDING               // Submitted to provider; awaiting async confirmation
  AUTHORIZED            // Funds reserved; awaiting capture
  CAPTURE_PENDING       // Capture requested; awaiting provider confirmation
  CAPTURED              // Funds successfully captured
  SUCCEEDED             // Payment fully settled (synonym for CAPTURED in some flows)
  FAILED                // Definitively failed — no retry without new payment
  CANCELLED             // Cancelled before capture (e.g., Rx rejected, user abort)
  PARTIALLY_REFUNDED    // One or more partial refunds applied
  REFUNDED              // Full refund settled
  DISPUTED              // Chargeback / dispute opened by cardholder
  CHARGEBACK            // Chargeback confirmed by provider
  UNKNOWN               // State cannot be determined; requires reconciliation
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  SKIPPED_DUPLICATE
}

enum ReconciliationStatus {
  MATCHED
  MISMATCH
  MISSING_INTERNAL
  MISSING_PROVIDER
  AMOUNT_MISMATCH
  CURRENCY_MISMATCH
  STATUS_MISMATCH
  RESOLVED
  UNDER_INVESTIGATION
}

enum RiskStatus {
  NOT_ASSESSED
  LOW
  MEDIUM
  HIGH
  BLOCKED
  REVIEW_REQUIRED
}

enum ShipmentStage {
  INDIA_BONDED_HUB
  INDIA_EXPORT_CUSTOMS
  INTERNATIONAL_AIR_TRANSIT
  US_PORT_OF_ENTRY
  OUT_FOR_DELIVERY
  DELIVERED
}

enum RewardStatus {
  PENDING
  CONFIRMED
  REDEEMED
  EXPIRED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum InventoryAllocationStatus {
  ALLOCATED
  PICKED
  PACKED
  RELEASED
}

// ------------------------------------------------------------------------------
// User, Customer & Admin Architecture
// ------------------------------------------------------------------------------

model User {
  id               String      @id @default(uuid())
  email            String      @unique
  passwordHash     String?
  role             UserRole    @default(PATIENT)
  status           UserStatus  @default(ACTIVE)
  firstName        String
  lastName         String
  phone            String?     // Application-layer encrypted
  dateOfBirth      DateTime?   // Application-layer encrypted
  emailVerified    Boolean     @default(false)
  phoneVerifiedAt  DateTime?
  twoFactorEnabled Boolean     @default(false)
  lastLoginAt      DateTime?

  // Profiles (1:1 separation of authentication identity from business roles)
  customer              Customer?
  admin                 Admin?

  // Direct Relations (preserved for backwards compatibility)
  addresses             Address[]
  orders                Order[]
  prescriptions         Prescription[]           @relation("PatientPrescriptions")
  verifiedPrescriptions Prescription[]           @relation("PharmacistVerifications")
  referralsMade         ReferralReward[]         @relation("Referrer")
  referralsReceived     ReferralReward[]         @relation("ReferredUser")
  auditLogs             AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@index([status])
}

model Customer {
  id                  String        @id @default(uuid())
  userId              String        @unique
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  customerType        CustomerType  @default(INDIVIDUAL)
  companyName         String?
  taxId               String?
  defaultCountryId    String?
  defaultCountry      Country?      @relation(fields: [defaultCountryId], references: [id], onDelete: SetNull)
  isVerified          Boolean       @default(false)

  // Relations
  addresses           Address[]
  orders              Order[]       @relation("CustomerOrders")
  prescriptions       Prescription[] @relation("CustomerPrescriptions")
  savedMedicines      SavedMedicine[]
  supportTickets      SupportTicket[]
  couponRedemptions   CouponRedemption[]
  referralsGiven      Referral[]    @relation("ReferrerCustomer")
  referralsReceived   Referral[]    @relation("ReferredCustomer")

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([userId])
  @@index([customerType])
  @@index([defaultCountryId])
}

model Admin {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  department  String    // "CLINICAL", "OPERATIONS", "COMPLIANCE", "FINANCE", "SUPPORT", "EXECUTIVE"
  accessLevel String    @default("STANDARD") // "READ_ONLY", "STANDARD", "SUPER_ADMIN"

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([department])
}

model Address {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  type        AddressType  @default(SHIPPING)
  line1       String
  line2       String?
  city        String
  state       String
  postalCode  String
  country     String       @default("US")
  isDefault   Boolean      @default(false)

  orders      Order[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@index([customerId])
  @@index([country])
}

// Immutable historical snapshot of addresses for each order
model OrderAddressSnapshot {
  id                     String    @id @default(uuid())
  orderId                String    @unique
  order                  Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  shippingRecipientName  String
  shippingPhone          String?
  shippingLine1          String
  shippingLine2          String?
  shippingCity           String
  shippingState          String
  shippingPostalCode     String
  shippingCountry        String

  billingRecipientName   String?
  billingPhone           String?
  billingLine1           String?
  billingLine2           String?
  billingCity            String?
  billingState           String?
  billingPostalCode      String?
  billingCountry         String?

  createdAt              DateTime  @default(now())
}

// ------------------------------------------------------------------------------
// Sourcing, Products & Multi-Variant Catalog
// ------------------------------------------------------------------------------

model Category {
  id                String            @id @default(uuid())
  name              String            @unique
  slug              String            @unique
  description       String?
  products          Product[]
  productCategories ProductCategory[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([slug])
}

model ProductCategory {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isPrimary   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
}

model Manufacturer {
  id                      String    @id @default(uuid())
  name                    String    @unique
  slug                    String?   @unique
  description             String?
  cdscoLicenseNumber      String    @unique
  usFdaRegistrationNumber String?
  facilityCity            String
  facilityState           String
  countryId               String?
  country                 Country?  @relation(fields: [countryId], references: [id], onDelete: SetNull)
  website                 String?
  status                  String    @default("ACTIVE")
  whoGmpCertified         Boolean   @default(true)
  verifiedAt              DateTime  @default(now())

  products                Product[]

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([slug])
  @@index([status])
}

model Product {
  id                    String             @id @default(uuid())
  sku                   String             @unique @default(cuid())
  name                  String             // Generic active name (e.g. "Atorvastatin Calcium")
  brandReferenceName    String             // e.g. "Generic for Lipitor"
  slug                  String             @unique
  activeIngredient      String
  strength              String             // e.g. "20mg" (canonical)
  dosageForm            String             // e.g. "Oral Tablet"
  packageSize           Int                @default(90) // Standard 90-day count
  ndcEquivalent         String?            // Reference U.S. NDC mapping
  description           String             @db.Text
  storageConditions     String             @default("Store at 20°C to 25°C (68°F to 77°F)")
  countryOfOrigin       String             @default("India")
  stockStatus           String             @default("AVAILABLE")
  
  // Transparent Pricing Model (USD) — canonical values
  fobPriceUsd           Decimal            @db.Decimal(10, 2)
  retailPriceUsd        Decimal            @db.Decimal(10, 2)
  usAverageCashPrice    Decimal            @db.Decimal(10, 2)

  // Regulatory Constraints
  isControlledSubstance Boolean            @default(false)
  requiresPrescription  Boolean            @default(true)
  isActive              Boolean            @default(true)

  manufacturerId        String
  manufacturer          Manufacturer       @relation(fields: [manufacturerId], references: [id])
  
  categoryId            String?
  category              Category?          @relation(fields: [categoryId], references: [id])

  // Multi-Variant & Relations
  variants              ProductVariant[]
  productCategories     ProductCategory[]
  regulatoryProfile     RegulatoryProfile?
  batches               Batch[]
  inventories           Inventory[]

  batchCertificates     BatchCertificate[]
  productDocuments      ProductDocument[]
  regulatoryRecords     RegulatoryRecord[]
  shippingEligibilities ShippingEligibility[]
  productFaqs           ProductFAQ[]
  orderItems            OrderItem[]
  productEligibilities  ProductEligibility[]
  cartItems             CartItem[]
  savedBy               SavedMedicine[]

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([slug])
  @@index([sku])
  @@index([name])
  @@index([brandReferenceName])
  @@index([activeIngredient])
  @@index([manufacturerId])
  @@index([categoryId])
}

model ProductVariant {
  id                  String             @id @default(uuid())
  productId           String
  product             Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                 String             @unique
  name                String?            // Variant descriptor (e.g. "Atorvastatin 40mg - 90 Tablets")
  strength            String             // e.g. "40mg"
  dosageForm          String             // e.g. "Film-Coated Tablet"
  packSize            Int                @default(90)
  unit                String             @default("TABLET")
  priceMinorUnits     Int                // Integer minor units (cents)
  currency            String             @default("USD")
  retailPriceUsd      Decimal            @db.Decimal(10, 2)
  fobPriceUsd         Decimal?           @db.Decimal(10, 2)
  status              String             @default("ACTIVE") // "ACTIVE", "INACTIVE", "DISCONTINUED"

  inventories         Inventory[]
  batches             Batch[]
  cartItems           CartItem[]
  orderItems          OrderItem[]

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([productId])
  @@index([sku])
  @@index([status])
}

model RegulatoryProfile {
  id                    String    @id @default(uuid())
  productId             String    @unique
  product               Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  classification        String    @default("PRESCRIPTION") // "OTC", "PRESCRIPTION", "SCHEDULE_H", "SCHEDULE_X"
  prescriptionRequired  Boolean   @default(true)
  controlledSubstance   Boolean   @default(false)
  personalImportAllowed Boolean   @default(true) // US FDA 90-day personal importation policy (CPG 110.300)
  maxSupplyDays         Int       @default(90)
  regulatoryStatus      String    @default("ACTIVE")
  fdaNdEquivalent       String?
  cdscoScheduleClass    String?   @default("Schedule H")
  notes                 String?   @db.Text

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([productId])
  @@index([classification])
}

model BatchCertificate {
  id                  String      @id @default(uuid())
  productId           String
  product             Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  lotNumber           String      @unique
  manufactureDate     DateTime
  expirationDate      DateTime
  purityPercentage    Decimal     @db.Decimal(5, 2)
  coaDocumentUrl      String
  releasedByQcOfficer String
  releasedAt          DateTime    @default(now())

  batch               Batch?
  orderItems          OrderItem[]

  createdAt           DateTime    @default(now())

  @@index([productId])
  @@index([lotNumber])
}

model Batch {
  id                   String                 @id @default(uuid())
  batchNumber          String
  productId            String
  product              Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariantId     String?
  productVariant       ProductVariant?        @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  manufactureDate      DateTime
  expiryDate           DateTime
  quantityManufactured Int
  quantityRemaining    Int
  status               String                 @default("RELEASED") // "RELEASED", "QUARANTINED", "RECALLED", "DEPLETED", "EXPIRED"

  batchCertificateId   String?                @unique
  batchCertificate     BatchCertificate?      @relation(fields: [batchCertificateId], references: [id], onDelete: SetNull)

  inventories          Inventory[]
  allocations          InventoryAllocation[]

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([productId, batchNumber])
  @@index([productId])
  @@index([productVariantId])
  @@index([expiryDate])
  @@index([status])
}

model Inventory {
  id                 String          @id @default(uuid())
  productId          String
  product            Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariantId   String?
  productVariant     ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  batchId            String?
  batch              Batch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)

  location           String          @default("MUMBAI_CENTRAL_BONDED_HUB")
  quantityOnHand     Int             @default(0)
  quantityReserved   Int             @default(0)
  quantityAvailable  Int             @default(0)
  reorderThreshold   Int             @default(50)
  version            Int             @default(1) // For optimistic concurrency

  updatedAt          DateTime        @updatedAt

  @@index([productId])
  @@index([productVariantId])
  @@index([batchId])
  @@index([location])
}

model InventoryAllocation {
  id                 String                     @id @default(uuid())
  orderItemId        String
  orderItem          OrderItem                  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  batchId            String
  batch              Batch                      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  quantityAllocated  Int
  status             InventoryAllocationStatus  @default(ALLOCATED)
  allocatedAt        DateTime                   @default(now())

  @@index([orderItemId])
  @@index([batchId])
}

model ProductDocument {
  id                 String   @id @default(uuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type               String   // "COA", "SPECIFICATION", "MANUFACTURER_LICENSE", "PACKAGING_INSERT", "REGULATORY"
  title              String
  fileUrl            String
  storageKey         String?  // Secure object storage key
  mimeType           String   @default("application/pdf")
  fileSizeBytes      Int?
  checksum           String?  // SHA-256 integrity hash
  version            Int      @default(1)
  verificationStatus String   @default("VERIFIED") // "VERIFIED", "PENDING_AUDIT", "UNVERIFIED"
  uploadedAt         DateTime @default(now())

  createdAt          DateTime @default(now())

  @@index([productId])
  @@index([type])
}

model RegulatoryRecord {
  id           String    @id @default(uuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  jurisdiction String
  status       String
  reference    String
  verifiedAt   DateTime  @default(now())
  expiresAt    DateTime?

  createdAt    DateTime  @default(now())

  @@index([productId])
  @@index([jurisdiction])
}

model ShippingEligibility {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  destination String
  status      String
  reason      String?
  updatedAt   DateTime @updatedAt

  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([destination])
}

model ProductFAQ {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  question     String
  answer       String   @db.Text
  displayOrder Int      @default(0)

  createdAt    DateTime @default(now())

  @@index([productId])
}

// ------------------------------------------------------------------------------
// Clinical Prescriptions (ePHI Protected)
// ------------------------------------------------------------------------------

model Prescription {
  id                 String             @id @default(uuid())
  userId             String
  user               User               @relation("PatientPrescriptions", fields: [userId], references: [id], onDelete: Cascade)
  customerId         String?
  customer           Customer?          @relation("CustomerPrescriptions", fields: [customerId], references: [id], onDelete: SetNull)

  prescriberName     String
  prescriberNpi      String?            // Application-level encrypted
  prescriberState    String?
  documentUrl        String             // Encrypted private storage key
  originalFileName   String?
  mimeType           String             @default("application/pdf")
  fileSizeBytes      Int
  documentHash       String?            // SHA-256 integrity hash

  status             PrescriptionStatus @default(PENDING_REVIEW)
  rejectionReasonCode String?           // Structured reason code (e.g. DOCUMENT_UNREADABLE)
  customerMessage    String?            @db.Text // Customer-facing explanation
  verificationNotes  String?            @db.Text // Internal staff-only notes
  verifiedByUserId   String?
  verifiedByUser     User?              @relation("PharmacistVerifications", fields: [verifiedByUserId], references: [id])
  verifiedAt         DateTime?
  reviewedByUserId   String?
  reviewedAt         DateTime?
  expiresAt          DateTime?
  version            Int                @default(1)

  refillsAuthorized  Int                @default(3)
  refillsRemaining   Int                @default(3)

  orders             Order[]

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([userId])
  @@index([customerId])
  @@index([status])
}

model SavedMedicine {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
}

// ------------------------------------------------------------------------------
// Orders, Checkout & Items (With Historical Snapshots)
// ------------------------------------------------------------------------------

model Order {
  id                 String              @id @default(uuid())
  orderNumber        String              @unique
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId         String?
  customer           Customer?           @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: SetNull)

  status             OrderStatus         @default(PENDING_PRESCRIPTION)

  // Financial Breakdown (USD)
  subtotalUsd        Decimal             @db.Decimal(10, 2)
  shippingUsd        Decimal             @db.Decimal(10, 2)
  dispensingFeeUsd   Decimal             @db.Decimal(10, 2)
  discountTotalUsd   Decimal             @db.Decimal(10, 2) @default(0.00)
  taxTotalUsd        Decimal             @db.Decimal(10, 2) @default(0.00)
  totalUsd           Decimal             @db.Decimal(10, 2)

  // Addresses & Prescriptions
  shippingAddressId  String
  shippingAddress    Address             @relation(fields: [shippingAddressId], references: [id])
  prescriptionId     String?
  prescription       Prescription?       @relation(fields: [prescriptionId], references: [id])

  // Coupon & Marketing
  couponId           String?
  coupon             Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponRedemption   CouponRedemption?

  // Immutable Order Address Snapshot
  addressSnapshot    OrderAddressSnapshot?

  // Relations
  items              OrderItem[]
  paymentTransaction PaymentTransaction?
  shipment           Shipment?
  payment            Payment?            @relation("OrderPayment")    // Phase 15
  refunds            Refund[]            @relation("OrderRefunds")    // Phase 15
  supportTickets     SupportTicket[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([userId])
  @@index([customerId])
  @@index([orderNumber])
  @@index([status])
  @@index([couponId])
}

model OrderItem {
  id                   String            @id @default(uuid())
  orderId              String
  order                Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            String
  product              Product           @relation(fields: [productId], references: [id])
  productVariantId     String?
  productVariant       ProductVariant?   @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  batchCertificateId   String?
  batchCertificate     BatchCertificate? @relation(fields: [batchCertificateId], references: [id])

  // Immutable historical purchase snapshots (Golden Database Rule: historical integrity)
  productNameSnapshot  String?
  skuSnapshot          String?
  manufacturerSnapshot String?
  batchNumberSnapshot  String?

  quantity             Int               @default(1)
  unitPriceUsd         Decimal           @db.Decimal(10, 2)
  unitPriceMinorUnits  Int?              // Cents representation
  totalPriceUsd        Decimal           @db.Decimal(10, 2)

  allocations          InventoryAllocation[]

  createdAt            DateTime          @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
}

// ------------------------------------------------------------------------------
// Marketing: Discounts, Coupons & Referrals
// ------------------------------------------------------------------------------

model Discount {
  id                 String        @id @default(uuid())
  name               String
  description        String?
  type               DiscountType  @default(PERCENTAGE)
  value              Decimal       @db.Decimal(10, 2) // e.g. 10.00 for 10% or $10.00
  currency           String        @default("USD")
  minOrderAmount     Decimal?      @db.Decimal(10, 2)
  maxDiscountAmount   Decimal?      @db.Decimal(10, 2)
  startAt            DateTime      @default(now())
  endAt              DateTime?
  status             String        @default("ACTIVE") // "ACTIVE", "EXPIRED", "DISABLED"

  coupons            Coupon[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status])
  @@index([startAt, endAt])
}

model Coupon {
  id                String             @id @default(uuid())
  code              String             @unique // Case-insensitive normalized code
  discountId        String
  discount          Discount           @relation(fields: [discountId], references: [id], onDelete: Cascade)
  usageLimit        Int?               // Total global redemptions allowed (null = unlimited)
  usageCount        Int                @default(0) // Concurrency-safe counter
  perCustomerLimit  Int                @default(1) // Max redemptions per customer
  startAt           DateTime           @default(now())
  endAt             DateTime?
  status            String             @default("ACTIVE") // "ACTIVE", "DEPLETED", "EXPIRED", "DISABLED"

  redemptions       CouponRedemption[]
  orders            Order[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([code])
  @@index([status])
}

model CouponRedemption {
  id             String    @id @default(uuid())
  couponId       String
  coupon         Coupon    @relation(fields: [couponId], references: [id], onDelete: Restrict)
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  discountAmount Decimal   @db.Decimal(10, 2)
  redeemedAt     DateTime  @default(now())

  @@index([couponId])
  @@index([customerId])
}

model Referral {
  id                 String        @id @default(uuid())
  referrerCustomerId String
  referrerCustomer   Customer      @relation("ReferrerCustomer", fields: [referrerCustomerId], references: [id], onDelete: Cascade)
  referredCustomerId String        @unique
  referredCustomer   Customer      @relation("ReferredCustomer", fields: [referredCustomerId], references: [id], onDelete: Cascade)
  referralCode       String
  rewardCreditUsd    Decimal       @db.Decimal(10, 2) @default(20.00)
  status             RewardStatus  @default(PENDING)
  convertedAt        DateTime?

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([referrerCustomerId])
  @@index([referredCustomerId])
  @@index([referralCode])
}

model ReferralReward {
  id             String       @id @default(uuid())
  referrerId     String
  referrer       User         @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId String       @unique
  referredUser   User         @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  creditUsd      Decimal      @db.Decimal(10, 2) @default(20.00)
  status         RewardStatus @default(PENDING)
  redeemedAt     DateTime?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([referrerId])
  @@index([referredUserId])
}

// ------------------------------------------------------------------------------
// Customer Support System
// ------------------------------------------------------------------------------

model SupportTicket {
  id              String          @id @default(uuid())
  ticketNumber    String          @unique // e.g. "TICK-2026-0001"
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderId         String?
  order           Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subject         String
  description     String          @db.Text
  priority        TicketPriority  @default(MEDIUM)
  status          TicketStatus    @default(OPEN)
  assignedTo      String?         // Admin userId
  resolvedAt      DateTime?
  resolutionNotes String?         @db.Text

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([customerId])
  @@index([orderId])
  @@index([status])
  @@index([priority])
  @@index([ticketNumber])
}

// ------------------------------------------------------------------------------
// Gateway-Agnostic Payment Transaction Ledger (Legacy)
// ------------------------------------------------------------------------------

model PaymentTransaction {
  id                    String        @id @default(uuid())
  orderId               String        @unique
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  providerId            String        // e.g. "mock", "stripe", "checkout-com", "healthcare-acquirer"
  externalTransactionId String?       @unique
  status                PaymentStatus @default(DRAFT)
  amountUsd             Decimal       @db.Decimal(10, 2)
  currency              String        @default("USD")
  
  authorizedAt          DateTime?
  capturedAt            DateTime?
  refundedAt            DateTime?
  failureReason         String?

  metadata              Json?

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
}

// ------------------------------------------------------------------------------
// Cross-Border Fulfillment & Milestone Logistics
// ------------------------------------------------------------------------------

model Shipment {
  id                 String          @id @default(uuid())
  orderId            String          @unique
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  carrier            String          // "DHL_EXPRESS" | "FEDEX_CROSSBORDER" | "USPS"
  service            String?         // e.g. "PRIORITY_MEDICAL_AIR"
  trackingNumber     String          @unique
  currentStage       ShipmentStage   @default(INDIA_BONDED_HUB)
  originCountry      String          @default("IN")
  destinationCountry String          @default("US")
  
  shippedAt          DateTime?
  estimatedDelivery  DateTime?
  actualDelivery     DateTime?

  events             TrackingEvent[]

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([orderId])
  @@index([trackingNumber])
  @@index([currentStage])
}

model TrackingEvent {
  id          String        @id @default(uuid())
  shipmentId  String
  shipment    Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  stage       ShipmentStage
  location    String        // e.g., "Mumbai Hub, India" or "JFK Airport, NY"
  description String
  eventTime   DateTime      @default(now())

  createdAt   DateTime      @default(now())

  @@index([shipmentId])
  @@index([eventTime])
  @@index([stage])
}

// ------------------------------------------------------------------------------
// Immutable Security & Compliance Audit Trail
// ------------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorUserId   String?  // Explicit actor identifier
  userRole      String?
  action        String   // e.g. "PRESCRIPTION_VIEWED", "ORDER_APPROVED", "INVENTORY_ADJUSTED"
  resourceType  String   // e.g. "Prescription", "Order", "User", "Inventory"
  resourceId    String
  previousState Json?
  newState      Json?
  ipAddress     String?
  userAgent     String?
  metadata      Json?

  timestamp     DateTime @default(now())

  @@index([userId])
  @@index([actorUserId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([timestamp])
}

// ------------------------------------------------------------------------------
// Multi-Country, Jurisdiction & Operational Product Eligibility Engine
// ------------------------------------------------------------------------------

model Country {
  id                   String               @id @default(uuid())
  code                 String               @unique // e.g. "US", "IN", "GB", "CA"
  name                 String               // e.g. "United States", "India"
  currency             String               @default("USD")
  phoneCode            String?
  isActive             Boolean              @default(true)

  jurisdictions        Jurisdiction[]
  productEligibilities ProductEligibility[]
  countryRules         CountryRule[]
  manufacturers        Manufacturer[]
  customers            Customer[]

  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([code])
  @@index([isActive])
}

model CountryRule {
  id                   String    @id @default(uuid())
  countryId            String
  country              Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  scope                String    @default("COUNTRY_WIDE") // "COUNTRY_WIDE", "CATEGORY", "PRODUCT"
  targetId             String?   // Optional productId or categoryId
  ruleCode             String    // e.g. "PERSONAL_IMPORT_90_DAY", "PREAUTH_REQUIRED"
  allowed              Boolean   @default(true)
  prescriptionRequired Boolean   @default(true)
  shippingAllowed      Boolean   @default(true)
  paymentAllowed       Boolean   @default(true)
  requiresReview       Boolean   @default(false)
  maxSupplyDays        Int       @default(90)
  version              Int       @default(1)
  status               String    @default("ACTIVE")
  effectiveFrom        DateTime  @default(now())
  effectiveTo          DateTime?
  rationale            String?   @db.Text

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([countryId])
  @@index([ruleCode])
  @@index([status])
  @@index([effectiveFrom, effectiveTo])
}

model Jurisdiction {
  id                   String               @id @default(uuid())
  countryId            String
  country              Country              @relation(fields: [countryId], references: [id], onDelete: Cascade)
  code                 String               @unique // e.g. "US-CA", "US-NY", "IN-MH"
  name                 String
  type                 String               @default("STATE")
  isActive             Boolean              @default(true)

  productEligibilities ProductEligibility[]

  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([countryId])
  @@index([code])
}

model ProductEligibility {
  id                   String        @id @default(uuid())
  productId            String
  product              Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  countryId            String
  country              Country       @relation(fields: [countryId], references: [id], onDelete: Cascade)
  jurisdictionId       String?
  jurisdiction         Jurisdiction? @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)

  status               String
  prescriptionRequired Boolean       @default(true)
  verificationRequired Boolean       @default(false)
  shippingAllowed      Boolean       @default(true)
  fulfillmentAllowed   Boolean       @default(true)
  maxSupplyDays        Int           @default(90)
  reason               String?

  effectiveFrom        DateTime      @default(now())
  effectiveUntil       DateTime?
  lastReviewedAt       DateTime      @default(now())
  reviewedBy           String?

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([productId])
  @@index([countryId])
  @@index([jurisdictionId])
  @@index([status])
}

// ------------------------------------------------------------------------------
// Cart & Session Architecture
// ------------------------------------------------------------------------------

model Cart {
  id                          String            @id @default(uuid())
  sessionToken                String            @unique
  userId                      String?
  destinationCountryCode      String            @default("US")
  destinationJurisdictionCode  String?
  status                      String            @default("ACTIVE")

  items                       CartItem[]
  checkoutSessions            CheckoutSession[]

  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  @@index([sessionToken])
  @@index([userId])
  @@index([status])
}

model CartItem {
  id                  String          @id @default(uuid())
  cartId              String
  cart                Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId           String
  product             Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariantId    String?
  productVariant      ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  quantity            Int             @default(1)
  unitPriceSnapshotUsd Decimal?       @db.Decimal(10, 2)

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@index([productVariantId])
}

// ------------------------------------------------------------------------------
// Checkout Session & State Machine
// ------------------------------------------------------------------------------

model CheckoutSession {
  id                          String    @id @default(uuid())
  cartId                      String
  cart                        Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sessionToken                String
  userId                      String?
  status                      String    @default("CUSTOMER_INFO")

  currency                    String    @default("USD")
  destinationCountryCode      String    @default("US")
  destinationJurisdictionCode  String?

  subtotalUsd                 Decimal   @db.Decimal(10, 2)
  shippingUsd                 Decimal   @db.Decimal(10, 2)
  estimatedTaxUsd             Decimal   @db.Decimal(10, 2) @default(0.00)
  totalUsd                    Decimal   @db.Decimal(10, 2)

  eligibilitySnapshot         Json?
  customerInfo                Json?
  shippingAddress             Json?
  shippingMethod              Json?
  prescriptionRef             String?
  verificationRef             String?

  idempotencyKey              String    @unique
  orderId                     String?   @unique

  expiresAt                   DateTime
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([cartId])
  @@index([sessionToken])
  @@index([idempotencyKey])
  @@index([status])
}

// ==============================================================================
// PHASE 15 — PAYMENT ARCHITECTURE (PRESERVED 100%)
// Provider-agnostic, secure, extensible payment infrastructure.
// ==============================================================================

model PaymentProviderConfig {
  id                        String    @id @default(uuid())
  code                      String    @unique  // e.g. "mock", "checkout-com", "adyen"
  name                      String
  environment               String    @default("sandbox")
  enabled                   Boolean   @default(false)

  supportsCards             Boolean   @default(true)
  supportsAuthorization     Boolean   @default(true)
  supportsCapture           Boolean   @default(true)
  supportsRefunds           Boolean   @default(true)
  supportsPartialRefunds    Boolean   @default(true)
  supportsWebhooks          Boolean   @default(true)
  supportsInternational     Boolean   @default(false)
  supportsCrossBorder       Boolean   @default(false)
  supportsChargebacks       Boolean   @default(false)

  supportedCurrencies       String[]
  supportedCountries        String[]
  settlementCurrency        String    @default("USD")
  merchantCountry           String    @default("IN")

  pharmaCategoryApproved    Boolean   @default(false)
  pharmaCategoryNotes       String?
  crossBorderNotes          String?

  captureMode               String    @default("manual")
  webhookEndpointPath       String?

  payments                  Payment[]

  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([code])
  @@index([enabled])
}

model Payment {
  id                    String                @id @default(uuid())
  paymentNumber         String                @unique

  orderId               String                @unique
  order                 Order                 @relation("OrderPayment", fields: [orderId], references: [id])

  userId                String

  providerId            String
  provider              PaymentProviderConfig  @relation(fields: [providerId], references: [code])

  status                InternalPaymentStatus @default(CREATED)
  riskStatus            RiskStatus            @default(NOT_ASSESSED)

  amountMinorUnits      Int
  capturedMinorUnits    Int                   @default(0)
  refundedMinorUnits    Int                   @default(0)
  currency              String

  providerPaymentId     String?
  providerClientToken   String?

  captureMode           String                @default("manual")

  authorizedAt          DateTime?
  capturedAt            DateTime?
  failedAt              DateTime?
  cancelledAt           DateTime?
  expiresAt             DateTime?

  idempotencyKey        String?               @unique
  failureCode           String?
  failureMessage        String?

  metadata              Json?

  attempts              PaymentAttempt[]
  refunds               Refund[]
  webhookEvents         WebhookEvent[]
  reconciliationRecords ReconciliationRecord[]
  auditEvents           PaymentAuditEvent[]

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([providerPaymentId])
  @@index([paymentNumber])
}

model PaymentAttempt {
  id                         String                @id @default(uuid())
  attemptNumber              Int

  paymentId                  String
  payment                    Payment               @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  providerId                 String
  operation                  String
  status                     InternalPaymentStatus

  providerAttemptId          String?
  requestedAmountMinorUnits  Int?
  responseAmountMinorUnits   Int?
  currency                   String?

  startedAt                  DateTime              @default(now())
  completedAt                DateTime?
  durationMs                 Int?

  errorCode                  String?
  errorMessage               String?

  metadata                   Json?

  createdAt                  DateTime              @default(now())

  @@index([paymentId])
  @@index([status])
  @@index([providerAttemptId])
}

model Refund {
  id                String        @id @default(uuid())
  refundNumber      String        @unique

  paymentId         String
  payment           Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  orderId           String
  order             Order         @relation("OrderRefunds", fields: [orderId], references: [id], onDelete: Restrict)

  amountMinorUnits  Int
  currency          String

  providerRefundId  String?       @unique
  providerId        String

  reason            String
  notes             String?       @db.Text

  status            RefundStatus  @default(REQUESTED)
  requestedBy       String
  requestedByRole   String
  completedAt       DateTime?
  failureReason     String?

  idempotencyKey    String?       @unique

  metadata          Json?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([paymentId])
  @@index([orderId])
  @@index([status])
  @@index([providerRefundId])
}

model WebhookEvent {
  id                  String                  @id @default(uuid())

  provider            String
  providerEventId     String
  eventType           String
  normalizedEventType String?

  paymentId           String?
  payment             Payment?                @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  processingStatus    WebhookProcessingStatus @default(RECEIVED)
  receivedAt          DateTime                @default(now())
  processedAt         DateTime?
  processingError     String?

  signatureVerified   Boolean                 @default(false)
  payloadHash         String?

  rawPayload          Json?

  createdAt           DateTime                @default(now())

  @@unique([provider, providerEventId])
  @@index([provider])
  @@index([paymentId])
  @@index([processingStatus])
  @@index([receivedAt])
}

model ReconciliationRecord {
  id                        String                @id @default(uuid())

  provider                  String
  providerTransactionId     String?
  internalPaymentId         String?
  payment                   Payment?              @relation(fields: [internalPaymentId], references: [id], onDelete: SetNull)

  internalAmountMinorUnits  Int?
  providerAmountMinorUnits  Int?
  differenceMinorUnits      Int?
  currency                  String?

  internalStatus            String?
  providerStatus            String?

  reconciliationStatus      ReconciliationStatus
  detectedAt                DateTime              @default(now())
  resolvedAt                DateTime?
  resolutionNotes           String?               @db.Text
  resolvedBy                String?

  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  @@index([provider])
  @@index([internalPaymentId])
  @@index([reconciliationStatus])
  @@index([detectedAt])
}

model PaymentAuditEvent {
  id                String    @id @default(uuid())

  paymentId         String?
  payment           Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  orderId           String?
  attemptId         String?
  refundId          String?
  webhookEventId    String?
  requestId         String?

  action            String
  previousStatus    String?
  newStatus         String?

  actor             String?
  actorRole         String?
  ipAddress         String?

  providerId        String?
  providerEventId   String?

  amountMinorUnits  Int?
  currency          String?
  metadata          Json?

  timestamp         DateTime  @default(now())

  @@index([paymentId])
  @@index([orderId])
  @@index([action])
  @@index([actor])
  @@index([timestamp])
}
